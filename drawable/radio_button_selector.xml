<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE0E0"/> <!-- Light red background for selected state -->
            <stroke android:width="2dp" android:color="@color/colorPrimary"/> <!-- Primary color border -->
            <corners android:radius="8dp"/> <!-- Rounded corners -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- White background for default state -->
            <stroke android:width="1dp" android:color="#BDBDBD"/> <!-- Gray border -->
            <corners android:radius="8dp"/> <!-- Rounded corners -->
        </shape>
    </item>
</selector>